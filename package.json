{
	"name": "amd-tokenfactory-copilot",
	"publisher": "luotianyiismywife",
	"displayName": "AMD TokenFactory Provider for Copilot",
	"description": "Integrate AMD TokenFactory (Radeon AI) models into GitHub Copilot Chat. Supports OpenAI-compatible and Anthropic protocols.",
	"keywords": [
		"ai",
		"chat",
		"copilot",
		"github-copilot",
		"language-models",
		"llm",
		"amd",
		"tokenfactory",
		"radeon",
		"openai-compatible",
		"anthropic",
		"thinking",
		"git-commit"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/luotianyiismywife/amd-tokenfactory-copilot"
	},
	"homepage": "https://github.com/luotianyiismywife/amd-tokenfactory-copilot",
	"bugs": {
		"url": "https://github.com/luotianyiismywife/amd-tokenfactory-copilot/issues"
	},
	"version": "2.0.1",
	"engines": {
		"vscode": "^1.116.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"license": "MIT",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "amdtokenfactory",
				"displayName": "%providerDisplayName%",
				"managementCommands": ["amdtokenfactory.manageApiKeys"]
			}
		],
		"commands": [
			{
				"command": "amdtokenfactory.openSettings",
				"category": "%commandCategory%",
				"title": "%command.openSettings%"
			},
			{
				"command": "amdtokenfactory.generateGitCommitMessage",
				"title": "%command.generateCommit%",
				"category": "%commandCategory%",
				"icon": "$(wand)"
			},
			{
				"command": "amdtokenfactory.abortGitCommitMessage",
				"title": "%command.abortCommit%",
				"category": "%commandCategory%",
				"icon": "$(debug-stop)"
			},
			{
				"command": "amdtokenfactory.manageApiKeys",
				"category": "%commandCategory%",
				"title": "%command.manageApiKeys%"
			},
			{
				"command": "amdtokenfactory.syncPush",
				"category": "%commandCategory%",
				"title": "%command.syncPush%"
			},
			{
				"command": "amdtokenfactory.syncPull",
				"category": "%commandCategory%",
				"title": "%command.syncPull%"
			}
		],
		"walkthroughs": [
			{
				"id": "copilotProviderGettingStarted",
				"title": "%walkthrough.title%",
				"description": "%walkthrough.description%",
				"steps": [
					{
						"id": "setApiKey",
						"title": "%walkthrough.setApiKey.title%",
						"description": "%walkthrough.setApiKey.description%",
						"media": {
							"markdown": "resources/walkthrough/set-api-key.md"
						},
						"completionEvents": [
							"onCommand:amdtokenfactory.manageApiKeys"
						]
					},
					{
						"id": "showModels",
						"title": "%walkthrough.showModels.title%",
						"description": "%walkthrough.showModels.description%",
						"media": {
							"markdown": "resources/walkthrough/show-models.md"
						}
					},
					{
						"id": "advancedSettings",
						"title": "%walkthrough.advancedSettings.title%",
						"description": "%walkthrough.advancedSettings.description%",
						"media": {
							"markdown": "resources/walkthrough/advanced-settings.md"
						}
					}
				]
			}
		],
		"menus": {
			"scm/title": [
				{
					"command": "amdtokenfactory.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !amdtokenfactory.isGeneratingCommit"
				},
				{
					"command": "amdtokenfactory.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && amdtokenfactory.isGeneratingCommit"
				}
			],
			"commandPalette": [
				{
					"command": "amdtokenfactory.generateGitCommitMessage",
					"when": "config.git.enabled && !amdtokenfactory.isGeneratingCommit"
				},
				{
					"command": "amdtokenfactory.abortGitCommitMessage",
					"when": "config.git.enabled && amdtokenfactory.isGeneratingCommit"
				}
			]
		},
		"configuration": {
			"title": "%config.title%",
			"properties": {
				"amdTokenFactory.commitLanguage": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"English",
						"French",
						"Italian",
						"German",
						"Spanish",
						"Russian",
						"Chinese (Simplified)",
						"Chinese (Traditional)",
						"Japanese",
						"Korean",
						"Czech",
						"Portuguese (Brazil)",
						"Turkish",
						"Polish"
					],
					"enumDescriptions": [
						"%config.commitLanguage.auto.desc%",
						"%config.commitLanguage.enum.English.desc%",
						"%config.commitLanguage.enum.French.desc%",
						"%config.commitLanguage.enum.Italian.desc%",
						"%config.commitLanguage.enum.German.desc%",
						"%config.commitLanguage.enum.Spanish.desc%",
						"%config.commitLanguage.enum.Russian.desc%",
						"%config.commitLanguage.enum.ChineseSimplified.desc%",
						"%config.commitLanguage.enum.ChineseTraditional.desc%",
						"%config.commitLanguage.enum.Japanese.desc%",
						"%config.commitLanguage.enum.Korean.desc%",
						"%config.commitLanguage.enum.Czech.desc%",
						"%config.commitLanguage.enum.PortugueseBrazil.desc%",
						"%config.commitLanguage.enum.Turkish.desc%",
						"%config.commitLanguage.enum.Polish.desc%"
					],
					"description": "%config.commitLanguage.desc%"
				},
				"amdTokenFactory.commitModel": {
					"type": "string",
					"default": "DeepSeek-V4-Flash",
					"description": "%config.commitModel.desc%"
				},
				"amdTokenFactory.commitMessagePrompt": {
					"type": "string",
					"default": "",
					"description": "%config.commitMessagePrompt.desc%"
				},
				"amdTokenFactory.requestTimeout": {
					"type": "number",
					"default": 600000,
					"minimum": 10000,
					"description": "%config.requestTimeout.desc%"
				},
				"amdTokenFactory.recentCommitsCount": {
					"type": "number",
					"default": 10,
					"minimum": 0,
					"maximum": 50,
					"description": "%config.recentCommitsCount.desc%"
				},
				"amdTokenFactory.commitIncludeCommitDiff": {
					"type": "boolean",
					"default": false,
					"description": "%config.commitIncludeCommitDiff.desc%"
				},
				"amdTokenFactory.commitAttachContextFiles": {
					"type": "boolean",
					"default": true,
					"description": "%config.commitAttachContextFiles.desc%"
				},
				"amdTokenFactory.modelPreset": {
					"type": "string",
					"default": "custom",
					"description": "%config.modelPreset.desc%",
					"editPresentation": "singlelineText"
				},
				"amdTokenFactory.temperature": {
					"type": "number",
					"default": 1,
					"minimum": 0,
					"maximum": 2,
					"description": "%config.temperature.desc%"
				},
				"amdTokenFactory.top_p": {
					"type": "number",
					"default": 0.5,
					"minimum": 0,
					"maximum": 1,
					"description": "%config.top_p.desc%"
				},
				"amdTokenFactory.enableAutoModelDiscovery": {
					"type": "boolean",
					"default": true,
					"description": "%config.enableAutoModelDiscovery.desc%"
				},
				"amdTokenFactory.syncModelsOnStartup": {
					"type": "boolean",
					"default": true,
					"description": "%config.syncModelsOnStartup.desc%"
				},
				"amdTokenFactory.maxInputTokensRatio": {
					"type": "number",
					"default": 1,
					"minimum": 0.1,
					"maximum": 1,
					"description": "%config.maxInputTokensRatio.desc%"
				},
				"amdTokenFactory.modelPresets": {
					"type": "array",
					"default": [
						{
							"id": "precise",
							"label": "Precise",
							"temperature": 0
						},
						{
							"id": "balanced",
							"label": "Balanced",
							"temperature": 1
						},
						{
							"id": "creative",
							"label": "Creative",
							"temperature": 1.2
						},
						{
							"id": "extra-creative",
							"label": "Extra Creative",
							"temperature": 1.7
						}
					],
					"items": {
						"type": "object",
						"required": [
							"id",
							"label",
							"temperature"
						],
						"properties": {
							"id": {
								"type": "string",
								"description": "%config.modelPreset.id.desc%"
							},
							"label": {
								"type": "string",
								"description": "%config.modelPreset.label.desc%"
							},
							"temperature": {
								"type": "number",
								"description": "%config.modelPreset.temperature.desc%"
							},
							"top_p": {
								"type": "number",
								"description": "%config.modelPreset.top_p.desc%"
							}
						}
					},
					"description": "%config.modelPresets.desc%"
				},
				"amdTokenFactory.visionProxyModel": {
					"type": "string",
					"default": "Qwen3.8-27B",
					"description": "%config.visionProxyModel.desc%"
				},
				"amdTokenFactory.visionProxyThinking": {
					"type": "boolean",
					"default": false,
					"description": "%config.visionProxyThinking.desc%"
				},
				"amdTokenFactory.apiMode": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"openai",
						"anthropic"
					],
					"enumDescriptions": [
						"%config.apiMode.enum.auto.desc%",
						"%config.apiMode.enum.openai.desc%",
						"%config.apiMode.enum.anthropic.desc%"
					],
					"description": "%config.apiMode.desc%"
				},
				"amdTokenFactory.enableAnthropicApi": {
					"type": "boolean",
					"default": false,
					"description": "%config.enableAnthropicApi.desc%"
				},
				"amdTokenFactory.apiKeyMode": {
					"type": "string",
					"enum": [
						"sticky",
						"rotation",
						"single"
					],
					"default": "sticky",
					"enumDescriptions": [
						"%config.apiKeyMode.enum.sticky.desc%",
						"%config.apiKeyMode.enum.rotation.desc%",
						"%config.apiKeyMode.enum.single.desc%"
					],
					"description": "%config.apiKeyMode.desc%"
				},
				"amdTokenFactory.singleKeyFallback": {
					"type": "string",
					"enum": [
						"error",
						"switch"
					],
					"default": "switch",
					"enumDescriptions": [
						"%config.singleKeyFallback.enum.error.desc%",
						"%config.singleKeyFallback.enum.switch.desc%"
					],
					"description": "%config.singleKeyFallback.desc%"
				},
				"amdTokenFactory.errorRules": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"code": {
								"type": "string",
								"description": "Error body error.code field (exact match, primary match field)"
							},
							"message": {
								"type": "string",
								"description": "Descriptive label only (not used for matching)"
							},
							"statusCode": {
								"type": "number",
								"description": "HTTP status code fallback"
							},
							"action": {
								"type": "string",
								"enum": [
									"retrySameKey",
									"rotateCooldown",
									"rotatePersist"
								]
							}
						},
						"required": [
							"action"
						]
					},
					"default": [
						{
							"statusCode": 401,
							"message": "无效 key",
							"action": "rotatePersist"
						},
						{
							"statusCode": 402,
							"message": "余额不足",
							"action": "rotatePersist"
						},
						{
							"statusCode": 429,
							"message": "限流",
							"action": "rotateCooldown"
						},
						{
							"statusCode": 502,
							"message": "网关错误",
							"action": "rotateCooldown"
						},
						{
							"statusCode": 503,
							"message": "服务端繁忙",
							"action": "rotateCooldown"
						},
						{
							"statusCode": 504,
							"message": "网关超时",
							"action": "rotateCooldown"
						},
						{
							"statusCode": 500,
							"message": "内部错误",
							"action": "retrySameKey"
						}
					],
					"description": "%config.errorRules.desc%"
				},
				"amdTokenFactory.apiKeyExhaustedCooldownMin": {
					"type": "number",
					"default": 10,
					"minimum": 0,
					"description": "%config.apiKeyExhaustedCooldownMin.desc%"
				},
				"amdTokenFactory.transientRetryTimes": {
					"type": "number",
					"default": 3,
					"minimum": 0,
					"maximum": 10,
					"description": "%config.transientRetryTimes.desc%"
				},
				"amdTokenFactory.cloudSyncAutoPull": {
					"type": "boolean",
					"default": true,
					"description": "%config.cloudSyncAutoPull.desc%"
				},
				"amdTokenFactory.cloudSyncAutoPush": {
					"type": "boolean",
					"default": false,
					"description": "%config.cloudSyncAutoPush.desc%"
				},
				"amdTokenFactory.delay": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "%config.delay.desc%"
				},
				"amdTokenFactory.readFileLines": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "%config.readFileLines.desc%"
				},
				"amdTokenFactory.visionMaxRounds": {
					"type": "number",
					"default": 5,
					"minimum": 1,
					"maximum": 20,
					"description": "%config.visionMaxRounds.desc%"
				},
				"amdTokenFactory.retry.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%config.retry.enabled.desc%"
				},
				"amdTokenFactory.retry.maxAttempts": {
					"type": "number",
					"default": 2,
					"minimum": 1,
					"maximum": 10,
					"description": "%config.retry.maxAttempts.desc%"
				},
				"amdTokenFactory.retry.intervalMs": {
					"type": "number",
					"default": 1000,
					"minimum": 0,
					"description": "%config.retry.intervalMs.desc%"
				}
			}
		}
	},
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"clean": "node scripts/build/clean.mjs",
		"compile": "node scripts/build/clean.mjs && tsc -p ./ && node scripts/build/build-info.mjs && node scripts/dev/check-settings.mjs",
		"audit": "node scripts/dev/audit-all.mjs",
		"port": "node scripts/dev/port.mjs",
		"lint": "eslint",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && npm run test:offline",
		"test:offline": "node test/test-transient-retry.mjs && node test/test-keys.mjs && node test/test-rotation.mjs && node test/test-banned-rotation.mjs && node test/test-vision-history.mjs && node test/test-anthropic-tool-result-merge.mjs && node test/test-anthropic-image-index.mjs && node test/test-anthropic-vision-order.mjs && node test/test-image-dimensions.mjs && node test/test-sse-stream.mjs && node test/test-split-tool-call-args.mjs && node test/test-batch-import.mjs && node test/test-cloud-sync-auto-push.mjs && node test/test-cloud-sync-flow.mjs",
		"test:e2e": "node test/test-cloud-sync-e2e.mjs",
		"build": "node scripts/build/package-vsix.mjs",
		"postinstall": "node scripts/build/copy-tokenizer.js"
	},
	"dependencies": {
		"@microsoft/tiktokenizer": "^1.0.10"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.4",
		"@types/vscode": "1.116.0",
		"eslint": "^10.12.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.71.1"
	}
}
